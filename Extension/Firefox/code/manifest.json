{
  "manifest_version": 2,
  "name": "WebBuddy",
  "version": "1.0",
  "description": "WebBuddy - Keeping people safe online",
  "permissions": [
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["scanner.js"]
  },
  "icons": {
  "16": "icons/logo-16.png",
  "32": "icons/logo-32.png",
  "48": "icons/logo-48.png",
  "128": "icons/logo-128.png",
  "256": "icons/logo-256.png"
},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["blocker.js"],
      "css": ["blocker.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "blocker.js",
    "blocker.css"
  ]
}